
BoxLayout:
  orientation: 'vertical'
  
  TextInput:
    id: pantalla
    text: ""
    readonly: True

    font_size: '32sp'

  GridLayout:
    rows: 4
    cols: 4

    background_color: 1, 1, 1, 1
    Button:
      text: "1"
      on_press: pantalla.text += self.text
    Button:
      text: "2"
      on_press: pantalla.text += self.text
    Button:
      text: "3"
      on_press: pantalla.text += self.text
    Button:
      text: "+"
      on_press: pantalla.text += self.text
      background_color: 0, 1, 0, 1
    Button:
      text: "4"
      on_press: pantalla.text += self.text
    Button:
      text: "5"
      on_press: pantalla.text += self.text
    Button:
      text: "6"
      on_press: pantalla.text += self.text
    Button:
      text: "-"
      on_press: pantalla.text += self.text
      background_color: 0, 1, 0, 1
    Button:
      text: "7"
      on_press: pantalla.text += self.text
    Button:
      text: "8"
      on_press: pantalla.text += self.text
    Button:
      text: "9"
      on_press: pantalla.text += self.text
    Button:
      text: "*"
      on_press: pantalla.text += self.text
      background_color: 0, 1, 0, 1
    Button: 
      text: "AC"
      on_press: pantalla.text = ""
      background_color: 1, 0, 0, 1
    Button:
      text: "0"
      on_press: pantalla.text += self.text
    Button:
      text: "="
      on_press: pantalla.text = str(eval(pantalla.text))
      background_color: 0, 0, 1, 1
      
    Button:
      text: "/"
      on_press: pantalla.text += self.text
      background_color: 0, 1, 0, 1
    
